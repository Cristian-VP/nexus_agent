# ──────────────────────────────────────────────────────────────
# NEXUS AGENT — Variables de Entorno
# Copia este archivo como .env y rellena los valores reales.
# ¡NUNCA subas el archivo .env a git!
# ──────────────────────────────────────────────────────────────

# Token de seguridad del gateway OpenClaw.
# Se genera automáticamente durante el onboarding.
# Déjalo vacío antes del onboarding; se rellenará solo.
OPENCLAW_GATEWAY_TOKEN=

# Zona horaria del contenedor
OPENCLAW_TZ=Europe/Madrid
