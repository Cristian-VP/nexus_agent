# ──────────────────────────────────────────────────────────────
# NEXUS AGENT — Variables de Entorno
# Copia este archivo como .env y rellena los valores reales.
# ¡NUNCA subas el archivo .env a git!
# ──────────────────────────────────────────────────────────────

# Token de seguridad del gateway OpenClaw.
# Se genera automáticamente durante el onboarding.
# Déjalo vacío antes del onboarding; se rellenará solo.
OPENCLAW_GATEWAY_TOKEN=

# Zona horaria del contenedor
OPENCLAW_TZ=Europe/Madrid

# Red interna del gateway OpenClaw utilizada por backend-bridge
OPENCLAW_GATEWAY_URL=http://nexus-agent-gateway:18789

# Base URLs internas y públicas de la nueva arquitectura
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://backend-bridge:4000
# BACKEND_BRIDGE_URL se usa dentro de Docker Compose.
# En desarrollo local con frontend-ui, el fallback apunta a http://localhost:4000.
BACKEND_BRIDGE_URL=http://backend-bridge:4000

# PostgreSQL y Redis
POSTGRES_DB=nexus_agent
POSTGRES_USER=nexus_agent
POSTGRES_PASSWORD=nexus_agent_password
DATABASE_URL=postgres://nexus_agent:nexus_agent_password@postgres:5432/nexus_agent
REDIS_URL=redis://redis:6379

# Secretos de backend
SESSION_SECRET=change-me-in-production
TOKEN_ENCRYPTION_KEY=change-me-in-production
COOKIE_SECURE=false

# OAuth 2.0 de Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Ajustes opcionales
OAUTH_STATE_TTL_SECONDS=600
GOOGLE_REFRESH_LEEWAY_SECONDS=60

# Provider API keys (optional) — set these to enable OpenAI-compatible endpoints
# Example: OPENAI_API_KEY=sk-...
OPENAI_API_KEY=
OPENAI_ORG=
HUGGINGFACE_API_KEY=

# Google API key (for Gemini/Vertex or web-search integrations)
# Example: GOOGLE_API_KEY=AIzaSy... (keep secret)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# For Google Gemini or other providers you may need additional configuration
# See OpenClaw documentation for provider-specific setup.
